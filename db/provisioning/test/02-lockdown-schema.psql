-- UNAPPLIED PROPOSAL. Run as the same authorized administrator in NEW test DB only.
\set ON_ERROR_STOP on
BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '10s';
DO $$
BEGIN
    IF current_database() <> 'campus_plus_test'
       OR host(inet_server_addr()) IS DISTINCT FROM '127.0.0.1'
       OR inet_server_port() IS DISTINCT FROM 5434
       OR current_setting('server_version_num')::integer NOT BETWEEN 170000 AND 179999
       OR (SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname=current_database())
          IS DISTINCT FROM 'campus_plus_test_migrator' THEN
        RAISE EXCEPTION 'Unauthorized test database or owner';
    END IF;
    IF EXISTS (SELECT FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
               WHERE n.nspname='public') THEN
        RAISE EXCEPTION 'Expected empty test schema before migration';
    END IF;
END $$;
REVOKE ALL ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO campus_plus_test_runner;
COMMIT;
